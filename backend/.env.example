# Copier en .env et remplir. Aucune valeur réelle dans le dépôt (règle 10).
CAEF_ENVIRONNEMENT=developpement
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Clé Fernet des champs restreints chiffrés : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAEF_CLE_CHIFFREMENT_CHAMPS=

POSTGRES_DB=caef
POSTGRES_USER=caef
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Stockage S3 compatible (MinIO en local). Vide : disque local (CAEF_STOCKAGE_LOCAL).
S3_BUCKET=caef-documents
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Mobile Money : « declaratif » tant qu'aucun contrat marchand n'existe (H16) ; « simulateur » hors production.
CAEF_PASSERELLE_MOBILE_MONEY=declaratif
CAEF_PASSERELLE_SIMULATEUR_SECRET=
CAEF_NUMERO_MARCHAND=
CAEF_CENTRE_PAIEMENTS_NON_REFERENCES=

# Seuil de seconde validation DG d'une proposition, en GNF (H5). Vide : pas de seconde validation.
CAEF_SEUIL_SECONDE_VALIDATION_PROPOSITION=

# Jeu de démonstration fictif ; vide : mot de passe tiré au hasard et affiché une fois.
CAEF_MOT_DE_PASSE_DEMO=
